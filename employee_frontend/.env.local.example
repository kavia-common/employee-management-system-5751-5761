# Example local environment variables for the React frontend
# Copy this file to .env.local and adjust values as needed.

# PUBLIC_INTERFACE
# REACT_APP_API_BASE_URL
# Base URL of the backend API. Do NOT include a trailing slash.
# Local development (FastAPI default port example):
REACT_APP_API_BASE_URL=http://localhost:3001

# PUBLIC_INTERFACE
# REACT_APP_LOG_LEVEL
# Logging level for API client in development: debug | info | warn | error
REACT_APP_LOG_LEVEL=info

# Employee Frontend - Environment Variables (development)

# Base URL for backend API (FastAPI)
# If backend runs on localhost at 3001:
REACT_APP_API_BASE_URL=http://localhost:3001

# If using a hosted preview backend, set to that URL instead:
# REACT_APP_API_BASE_URL=https://<your-backend-preview-host>:3001

# Client log level (debug, info, warn, error). Use 'info' for dev.
REACT_APP_LOG_LEVEL=info
